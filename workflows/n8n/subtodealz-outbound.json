      "parameters": {
        "jsCode": "// Convert current UTC time to Florida (Eastern Time)\nconst now = new Date();\nconst floridaTime = new Date(now.toLocaleString(\"en-US\", { timeZone: \"America/New_York\" }));\n\nconst day = floridaTime.getDay(); // 0 = Sunday, 6 = Saturday\nconst hour = floridaTime.getHours();\n\n// Check if current time is within Florida business hours (Mon–Fri, 9 AM–6 PM)\nconst isBusinessHours = (day >= 1 && day <= 5) && (hour >= 9 && hour < 18);\n\n// Helper function to calculate hour difference between two dates\nfunction hoursBetween(date1, date2) {\n  return Math.abs((date1 - date2) / (1000 * 60 * 60));\n}\n\n// Get all leads from previous node (Google Sheet1)\nconst allLeads = $input.all();\n\n// Filter leads according to your conditions\nconst filteredLeads = allLeads.filter(item => {\n  const lead = item.json;\n\n  // 1️⃣ Must be within Florida business hours\n  if (!isBusinessHours) return false;\n\n  // 2️⃣ Skip if lead has already been called\n  const status = (lead.Status || \"\").toLowerCase();\n  if (status.includes(\"ended\") || status.includes(\"completed\") || status.includes(\"answered\"))\n    return false;\n\n  // 3️⃣ Skip if lead was called within last 24 hours\n  if (lead[\"Last Called\"]) {\n    const lastCalled = new Date(lead[\"Last Called\"]);\n    const hoursSinceLastCall = hoursBetween(floridaTime, lastCalled);\n    if (hoursSinceLastCall < 24) return false;\n  }\n\n  // 4️⃣ Skip if total calls (tracked in Notes or separate field) ≥ 3\n  let callCount = 0;\n  const total_calls = (lead['Total Calls'] || \"\").toLowerCase();\n  const match = total_calls.match(/call\\s*count\\s*[:=]?\\s*(\\d+)/);\n\n  if (match) {\n    callCount = parseInt(match[1]);\n  } else if (total_calls.includes(\"called\")) {\n    // crude fallback: count keyword \"called\" occurrences\n    callCount = (total_calls.match(/called/g) || []).length;\n  }\n\n  if (callCount >= 3) return false;\n\n  // ✅ If all checks passed, include the lead\n  return true;\n});\n\n// Return leads that pass all conditions\nreturn filteredLeads.map(lead => ({\n  json: {\n    ...lead.json,\n    businessHours: isBusinessHours,\n    currentTime: floridaTime.toISOString(),\n    message: \"Lead passed all filters — within Florida business hours\"\n  }\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
