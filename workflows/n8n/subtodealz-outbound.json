      "parameters": {
        "jsCode": "// ✅ Get lead data safely from previous node\nconst leadData = $input.item ? $input.item.json : {};\n\n// ✅ Get OpenAI node result (AI output)\nconst aiData = $json;\n\n// Extract fields from AI response\nlet leadStatus = null;\nlet rentUpdated = false;\nlet newRentAmount = null;\n\n// Try parsing AI JSON content\ntry {\n  if (aiData.message && aiData.message.content) {\n    const parsed = JSON.parse(aiData.message.content);\n    leadStatus = parsed.lead_status || null;\n    rentUpdated = parsed.rent_updated || false;\n    newRentAmount = parsed.new_rent_amount || null;\n  }\n} catch (err) {\n  console.error(\"Error parsing AI response:\", err);\n}\n\n// ✅ Extract old rent from lead data\nconst oldRentRaw = leadData['Rent Amount'] || leadData.rent_amount;\nconst oldRent = oldRentRaw ? parseInt(String(oldRentRaw).replace(/[$,]/g, '')) : null;\n\n// ✅ Build final output\nconst output = {\n  ...leadData,\n  lead_status: leadStatus,\n  rent_updated: rentUpdated,\n  new_rent_amount: newRentAmount,\n  old_rent: oldRent,\n  note: rentUpdated\n    ? `Rent changed from $${oldRent} to $${newRentAmount}`\n    : `Rent confirmed at $${oldRent}`,\n};\n\n// ✅ Log for debugging\nconsole.log(\"Merged Lead Data:\", JSON.stringify(output, null, 2));\n\n// ✅ Return clean JSON\nreturn [{ json: output }];\n "
      },
