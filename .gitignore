# --- Secrets — NEVER commit ---
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
credentials.json

# --- Python ---
.venv/
.venv-*/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/

# --- Node ---
node_modules/
npm-debug.log*
yarn-error.log
