# ──────────────────────────────────────────────────────────────────────────────
# Provider selection — flip these and the app reloads with new providers
# ──────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai          # openai | anthropic | groq | gemini | cerebras | openrouter | nvidia | ollama
STT_PROVIDER=groq            # deepgram | openai | groq | local
TTS_PROVIDER=browser         # elevenlabs | openai | deepgram | cartesia | local | qwen3 | browser

# ──────────────────────────────────────────────────────────────────────────────
# Cloud LLMs
# ──────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cerebras — extremely fast (~2000 tok/s), free tier ~1M tok/day
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# OpenRouter — one API for hundreds of models, model IDs are provider-prefixed
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=voiceops-ai-agent

# NVIDIA NIM (build.nvidia.com) — 121 models, free ~1000 req/mo
# 70B works with tool-calling; 8B free-tier disables tools (times out).
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# ──────────────────────────────────────────────────────────────────────────────
# Local LLM (Ollama)
# ──────────────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ──────────────────────────────────────────────────────────────────────────────
# STT/TTS providers
# ──────────────────────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_TTS_VOICE=aura-asteria-en

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5

CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-2

# ──────────────────────────────────────────────────────────────────────────────
# Local STT/TTS
# ──────────────────────────────────────────────────────────────────────────────
LOCAL_WHISPER_MODEL=base.en
LOCAL_WHISPER_COMPUTE=int8
PIPER_BINARY=piper
PIPER_MODEL_PATH=

# ──────────────────────────────────────────────────────────────────────────────
# Qwen3-TTS (Alibaba, Apache 2.0)
# https://huggingface.co/collections/Qwen/qwen3-tts
# `pip install qwen-tts torch soundfile`
# ──────────────────────────────────────────────────────────────────────────────
QWEN3_TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
QWEN3_TTS_DEVICE=cuda:0                # cuda:0 | cpu | mps
QWEN3_TTS_DTYPE=bfloat16               # bfloat16 | float16 | float32
QWEN3_TTS_DEFAULT_SPEAKER=Vivian
QWEN3_TTS_DEFAULT_LANGUAGE=English
QWEN3_TTS_INSTRUCT=                    # optional style prompt
QWEN3_TTS_REF_AUDIO=                   # path/URL/base64 (cloning models only)
QWEN3_TTS_REF_TEXT=                    # transcript of ref audio

# ──────────────────────────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────────────────────────
# ──────────────────────────────────────────────────────────────────────────────
# Vapi (custom-LLM webhook + assistant provisioning)
# Grab keys from https://dashboard.vapi.ai
# ──────────────────────────────────────────────────────────────────────────────
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_URL=              # your backend URL Vapi will call (cloudflared/ngrok/prod)
VAPI_SECRET=                  # optional shared secret; if set we check it on every webhook
VAPI_ASSISTANT_ID=            # default assistant for /outbound/start_batch
VAPI_PHONE_NUMBER_ID=         # default caller-ID phone number for /outbound/start_batch

# Outbound transport (Product A): "vapi" for real phone calls, "local" to run
# the Qwen3-TTS emulator (no Vapi account, no Twilio, no phone number).
OUTBOUND_TRANSPORT=vapi

# Qwen3-TTS: use the 1.7B Base model for voice cloning-driven local outbound
# QWEN3_TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# QWEN3_TTS_REF_AUDIO=                  # path/URL to a 3-30s reference clip
# QWEN3_TTS_REF_TEXT=                   # transcript of that reference clip

# ──────────────────────────────────────────────────────────────────────────────
# GoHighLevel (Private Integration token)
# In GHL: Settings -> Private Integrations -> Create -> pick scopes -> copy token
# Scopes needed: contacts.write, contacts.readonly, opportunities.write,
#                calendars.readonly, calendars/events.write
# ──────────────────────────────────────────────────────────────────────────────
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_CALENDAR_ID=              # optional; only needed if you want GHL to own bookings
GHL_API_VERSION=2021-07-28

# ──────────────────────────────────────────────────────────────────────────────
# Google (service account for Calendar + Sheets)
# 1. cloud.google.com -> IAM -> Service Accounts -> create -> keys -> JSON
# 2. Share the target calendar and sheet with the service account email
# ──────────────────────────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=  # absolute path to the JSON key file
GOOGLE_CALENDAR_ID=           # e.g. primary or a specific @group.calendar.google.com
GOOGLE_SHEET_ID=              # from the sheet URL /d/<sheet_id>/edit
GOOGLE_SHEET_TAB=calls

# ──────────────────────────────────────────────────────────────────────────────
# CRM sink + calendar backend selection
# ──────────────────────────────────────────────────────────────────────────────
CRM_SINK=none                 # none | ghl | sheets | ghl+sheets
CALENDAR_BACKEND=fake         # fake | google

# ──────────────────────────────────────────────────────────────────────────────
# ElevenLabs-compatible endpoints (/v1/text-to-speech/*)
# Optional gate — if set, callers must send xi-api-key: <this> header
# ──────────────────────────────────────────────────────────────────────────────
COMPAT_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# WhatsApp Business Cloud API
# developers.facebook.com -> WhatsApp -> Configuration
# ──────────────────────────────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=          # any random string; same value goes in Meta dashboard
WHATSAPP_GRAPH_VERSION=v22.0

# ──────────────────────────────────────────────────────────────────────────────
# Telegram
# @BotFather -> /newbot -> copy token
# ──────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ──────────────────────────────────────────────────────────────────────────────
# Twilio (real phone calls via Media Streams)
# console.twilio.com -> phone number -> voice webhook -> POST /twilio/voice
# ──────────────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PUBLIC_URL=              # your backend URL — used to build the wss:// stream URL

# ──────────────────────────────────────────────────────────────────────────────
# App
# Leave blank to use repo-root-relative defaults.
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL=
BUSINESS_PROFILE_PATH=
CALENDAR_PATH=
CORS_ORIGINS=*

# ──────────────────────────────────────────────────────────────────────────────
# Router LLM (Sprint 4c — cross-provider fallover with cool-down)
# ──────────────────────────────────────────────────────────────────────────────
# Set LLM_PROVIDER=router to enable.  ORDER is comma-separated by priority.
# LLM_ROUTER_ORDER=groq,gemini,nvidia,openrouter
# LLM_ROUTER_COOLDOWN_S=30                  # skip failed provider for N seconds
# LLM_ROUTER_TIMEOUT_S=8                    # per-provider request timeout

# ──────────────────────────────────────────────────────────────────────────────
# AUTH — 2026-08-01 audit fix (SEC-001..SEC-004)
# ──────────────────────────────────────────────────────────────────────────────
# API_AUTH_ENFORCE controls whether Authorization: Bearer <key> is required
# on non-public routes.  Default TRUE.  Set to false only for local dev.
API_AUTH_ENFORCE=true
# Single key mapped to tenant "default":
API_KEY=
# OR multi-tenant JSON: {"sk_abc": "acme", "sk_xyz": "widgetco"}
API_KEYS_JSON=

# ──────────────────────────────────────────────────────────────────────────────
# Webhook signature enforcement — 2026-08-01 audit fix (WH-001..WH-005)
# ──────────────────────────────────────────────────────────────────────────────
# All default TRUE.  Set to false only for local dev with a mock provider.
TWILIO_SIGNATURE_ENFORCE=true
WHATSAPP_SIGNATURE_ENFORCE=true
TELEGRAM_SIGNATURE_ENFORCE=true
VAPI_SIGNATURE_ENFORCE=true
# WhatsApp Meta app secret (X-Hub-Signature-256):
WHATSAPP_APP_SECRET=
# Telegram webhook secret token:
TELEGRAM_WEBHOOK_SECRET=
# Vapi bearer token (must match your assistant's webhook auth config):
VAPI_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# Outbound dialer safety — 2026-08-01 audit fix (SEC-005, OUT-001..OUT-014)
# ──────────────────────────────────────────────────────────────────────────────
# /outbound/* routes return 503 unless this is explicitly enabled.  DO NOT
# turn on in production until the outbound-safety sprint ships (server-owned
# campaign config, mandatory consent, DNC from trusted store).
OUTBOUND_ROUTE_ENABLED=false

# ──────────────────────────────────────────────────────────────────────────────
# Environment guard — enforces production-mode invariants
# ──────────────────────────────────────────────────────────────────────────────
# Set to "production" to reject unsafe defaults (CORS *, no API keys, etc).
ENVIRONMENT=development
